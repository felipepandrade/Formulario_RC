# Emails must be Base64 encoded for security/obfuscation in the client bundle.
# Example: user@example.com -> dXNlckBleGFtcGxlLmNvbQ==
# All variables are required: `vite build` fails if any is missing or invalid.
# On Vercel, set them in Settings > Environment Variables (Production and Preview).
VITE_EMAIL_CATU_OI=
# ESOM_R_CATU_OI (ECOMP de Catu), separate from ESOM_F_CATU_OI (Base de Catu)
VITE_EMAIL_R_CATU_OI=
VITE_EMAIL_CAMACARI_OI=
VITE_EMAIL_ITABUNA_OI=
VITE_EMAIL_PILAR_OI=
VITE_EMAIL_ATALAIA_OI=
